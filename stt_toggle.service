[Unit]
Description=STT hotkey and status window
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/stt
ExecStartPre=/usr/bin/test -r %h/workspace/stt/.gemini_api_key
ExecStart=%h/miniconda3/bin/python3 %h/workspace/stt/stt_toggle.py --status-window --device plughw:CARD=Microphone,DEV=0
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
