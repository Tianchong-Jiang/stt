[Unit]
Description=STT hotkey and status window
After=graphical-session.target

[Service]
Type=simple
# This template assumes the checkout is ~/workspace/stt. Replace YOUR_PROJECT
# with the project whose vocabulary should be supplied as transcription context.
WorkingDirectory=%h/workspace/stt
ExecStartPre=/usr/bin/test -r %h/workspace/stt/.gemini_api_key
ExecStartPre=/usr/bin/test -x %h/workspace/stt/.venv/bin/gemini-stt-toggle
ExecStart=%h/workspace/stt/.venv/bin/gemini-stt-toggle --status-window --device default --repo %h/workspace/YOUR_PROJECT --cwd %h/workspace/YOUR_PROJECT
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
